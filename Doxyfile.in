PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@/src"
INPUT                  = "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/README.md"
FILE_PATTERNS          = *.cpp *.hpp *.c *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
GENERATE_XML           = YES
PROJECT_LOGO           = "@PROJECT_SOURCE_DIR@/rsc/icons/logo.svg"
PROJECT_ICON           = "@PROJECT_SOURCE_DIR@/rsc/icons/logo.svg"
HTML_COLORSTYLE_HUE    = 240
HTML_COLORSTYLE_SAT    = 10
HTML_COLORSTYLE_GAMMA  = 40
HTML_EXTRA_STYLESHEET  = "@PROJECT_SOURCE_DIR@/rsc/doxygen_custom.css"
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
